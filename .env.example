# Optional: used by training notebooks/tools that access Roboflow.
# Obtain this from your Roboflow project settings.
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Hosted pitch-keypoint model used to estimate the playing-area polygon.
FIELD_DETECTION_MODEL_ID=football-field-detection-f07vi/14
PITCH_KEYPOINT_CONFIDENCE_THRESHOLD=0.5
TOUCHLINE_TOLERANCE=18